    "code": "import pandas as pd\nimport os\nfile_path = '/input/المشتريات 2026.xlsx'\ndf = pd.read_excel(file_path)\nprint('Columns:', df.columns.tolist())\nprint(df.head())\n\n# Try to detect date and amount columns\ndate_col = None\namount_col = None\nfor col in df.columns:\n    col_str = str(col).lower()\n    if 'تاريخ' in col_str or 'date' in col_str:\n        date_col = col\n    if 'مبلغ' in col_str or 'قيمة' in col_str or 'amount' in col_str or 'price' in col_str or 'سعر' in col_str:\n        amount_col = col\n\nprint('Detected date_col:', date_col)\nprint('Detected amount_col:', amount_col)\n\nif date_col and amount_col:\n    df[date_col] = pd.to_datetime(df[date_col], errors='coerce')\n    df = df.dropna(subset=[date_col, amount_col])\n    df['month'] = df[date_col].dt.to_period('M').astype(str)\n    summary = df.groupby('month')[amount_col].sum().reset_index()\n    summary = summary.rename(columns={amount_col: 'الإجمالي'})\n    summary = summary.sort_values('month')\n    print(summary)\n    # Save to output\n    summary.to_csv('/output/اجمالي_المشتريات_شهريا.csv', index=False, encoding='utf-8-sig')\n    summary.to_html('/output/اجمالي_المشتريات_شهريا.html', index=False)\nelse:\n    print('Could not detect columns')"
