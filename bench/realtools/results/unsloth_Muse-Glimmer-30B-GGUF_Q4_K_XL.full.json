    "code": "import pandas as pd\nimport matplotlib.pyplot as plt\nimport os\n\nfile_path = '/input/الموظفون.xlsx'\ndf = pd.read_excel(file_path)\n\n# Assume department column name contains 'إدارة' or 'department'\n# Try to find column with department\ncol_candidates = [c for c in df.columns if 'إدارة' in str(c) or 'department' in str(c).lower() or 'قسم' in str(c)]\nif not col_candidates:\n    # fallback to second column\n    dept_col = df.columns[1]\nelse:\n    dept_col = col_candidates[0]\n\n# Clean column name\ndept_col = dept_col\n\ncounts = df[dept_col].value_counts(dropna=False).reset_index()\ncounts.columns = ['الإدارة', 'عدد الموظفين']\n\n# Save table\ncounts.to_csv('/output/عدد_الموظفين_حسب_الإدارة.csv', index=False, encoding='utf-8-sig')\n\n# Plot\nplt.figure(figsize=(10,6))\nplt.bar(counts['الإدارة'].astype(str), counts['عدد الموظفين'], color='steelblue')\nplt.xlabel('الإدارة')\nplt.ylabel('عدد الموظفين')\nplt.title('عدد الموظفين في كل إدارة')\nplt.xticks(rotation=45, ha='right')\nplt.tight_layout()\nplt.savefig('/output/عدد_الموظفين_حسب_الإدارة.png', dpi=150)\n\n# Also save HTML table\nhtml = f\"<h2>عدد الموظفين في كل إدارة</h2>\"\nhtml += counts.to_html(index=False, border=0)\nwith open('/output/عدد_الموظفين_حسب_الإدارة.html', 'w', encoding='utf-8') as f:\n    f.write(html)\n\nprint('Columns:', df.columns.tolist())\nprint(counts.to_string(index=False))"
