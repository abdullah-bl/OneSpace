# Copy to .env and fill in. Never commit .env.

# ---- web
APP_PORT=8090
# The address people open (used in links and file URLs).
ONEBASE_URL=https://onespace.example.org

# ---- sandbox (analysis): a long random secret shared by app and runner
#   openssl rand -hex 32
SANDBOX_SECRET=

# ---- models (OpenAI-compatible servers). Admins can also add providers later in the app:
#   إدارة المنصة → مزوّدو النماذج. These are the defaults the app starts with.
# On the host itself use host.docker.internal; with the "models" profile use llm-main / llm-fast / embed.
LLM_BASE_URL=http://host.docker.internal:8401/v1
LLM_MODEL=main
LLM_API_KEY=
LLM_FAST_BASE_URL=http://host.docker.internal:8402/v1
LLM_FAST_MODEL=fast
# Decision model (plans/12): small JSON decisions. Unset = the fast model above.
# LLM_DECIDE_BASE_URL=http://host.docker.internal:8095/v1
# LLM_DECIDE_MODEL=decide
EMBED_BASE_URL=http://host.docker.internal:8403/v1
EMBED_MODEL=embed
# Fixed once files are indexed (changing it means re-indexing everything).
EMBED_DIMENSIONS=768
# Optional
RERANK_BASE_URL=
RERANK_MODEL=
VISION_BASE_URL=
VISION_MODEL=
# Parallel model requests the GPU can take.
GPU_SLOTS=4

# ---- folder sync: the host folder holding mounted shares (read only in the app)
SHARES_DIR=./shares

# ---- local models (profile "models")
MODELS_DIR=./models
MAIN_MODEL_FILE=main.gguf
FAST_MODEL_FILE=fast.gguf
EMBED_MODEL_FILE=embed.gguf
